# 재판정이 밀렸으면 채운다 (명령서 14-3 · 마스터 지시 08-24).
# ★ 하루 여섯 번 보고 ★ 밀린 것만 채운다.  ★ 무조건 돌리지 않는다
# ★ 시각의 정본은 config/admin.json 의 recalc_catchup_at 이다 (V10-31) —
#   ★ 여기 OnCalendar 은 그것을 옮긴 것이다.  ★ 고칠 때 둘을 함께 고친다
[Unit]
Description=CarWatch v2 — 재판정 밀림 확인 (네 시간)

[Timer]
OnCalendar=*-*-* 01,05,09,13,17,21:00:00
# ★ 서버가 멎었다 살아나면 ★ 놓친 것을 한 번 돈다 (14-3 ③)
Persistent=true
Unit=carwatch-recalc-catchup.service

[Install]
WantedBy=timers.target
